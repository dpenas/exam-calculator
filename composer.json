{
    "name": "dpenas/exam-calculator",
    "description": "Assessment",
    "type": "project",
    "require": {
        "php": "^8.5",
        "phpoffice/phpspreadsheet": "^5.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "fix": "php-cs-fixer fix",
        "analyse": "php -l src"
    }
}